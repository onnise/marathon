# =====================================================
# Bikfaya Race 2026 — Environment Variables
# Copy this to .env.local for local dev.
# In production, add these in: Vercel Dashboard > Project > Settings > Environment Variables
# NEVER commit real values to git.
# =====================================================

# ── SUPABASE ──────────────────────────────────────────
# Get these from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── ADMIN PANEL ───────────────────────────────────────
# Set a strong password (you'll type this to log in at /admin.html)
ADMIN_PASSWORD=choose-a-strong-password-here

# A long random string used as the session token (generate with: openssl rand -hex 32)
ADMIN_TOKEN=generate-a-long-random-string-here

# ── SITE ──────────────────────────────────────────────
SITE_URL=https://bikfayarace.com

# ── EMAIL (add when ready) ────────────────────────────
# Resend.com (recommended — free 3,000 emails/month)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=Bikfaya Race <tickets@bikfayarace.com>

# ── OMT ePAY (add when credentials received) ──────────
# OMT_MERCHANT_ID=
# OMT_API_KEY=
# OMT_API_SECRET=
# OMT_EPAY_BASE_URL=https://

# ── STRIPE (add when confirmed) ───────────────────────
# STRIPE_SECRET_KEY=sk_live_xxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxx
